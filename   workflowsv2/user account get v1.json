            },
            {
                "parameters": {
                    "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n\n  let accounts = item.json.action.result\n  accounts = Array.isArray(accounts) ? accounts : [accounts]\n\n  accounts = accounts.filter(x => x?.[\"@type\"] == item.json.action.object['@type'])\n\n  accounts = accounts.filter(x => x?.system?.[\"@id\"] == item.json.action.object.system?.['@id'])\n\n  if(item.json.action.object.user?.['@id']){\n  accounts = accounts.filter(x => x?.user?.[\"@id\"] == item.json.action.object.user?.['@id'])\n  }\n\nif(item.json.config?.accountID){\n accounts = accounts.filter(x => x?.accountID == item.json.config?.accountID)\n  }\n\n  \n  let account = accounts?.[0]\n\n  if(account){\n    let credentials = account?.credential\n    credentials = Array.isArray(credentials) ? credentials : [credentials]\n  \n    credentials.forEach(x => x.startDate = x?.startDate ? new Date(x?.startDate) : undefined)\n  \n    credentials.forEach(x => x.endDate = x?.endDate ? new Date(x?.endDate) : undefined)\n  \n    credentials = credentials.filter( x => !x?.startDate  || x?.startDate <=   Date.now() )\n    credentials = credentials.filter( x => !x?.endDate  || x?.endDate >=   Date.now() )\n  \n    account.credential = credentials?.[credentials.length -1] || {}\n  \n  }\n  \n  item.json.action.result = account\n}\n\nreturn $input.all();"
                },
