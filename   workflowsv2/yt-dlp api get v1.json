            "name": "When Executed by Another Workflow"
        },
        {
            "parameters": {
                "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n\n  let bookmarks = []\n  for(let m of item.json.rawResults){\n\n    let r = {\n      \"@type\": \"BookmarkAction\",\n      \"@id\": \"https://karakeep.tactik8.com/bookmarks/\" + m.id,\n      \"object\":{\n        \"@type\": \"WebPage\",\n        \"@id\": m.content.url + \"#webpage\",\n        \"url\": m.content.url\n      },\n      \"startTime\": m.createdAt,\n      \"endTime\": m.modifiedAt,\n      \"agent\": {\n        \"@type\": \"Person\",\n        \"@id\": \"https://karakeep.tactik8.com/users/\" + m.userId\n      }\n     \n    }\n    bookmarks.push(r)\n    \n  }\n\n\n  item.json.results = (item.json.results || []).concat(bookmarks)\n}\n\n  return $input.all();"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
