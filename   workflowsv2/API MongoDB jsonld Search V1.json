        {
            "parameters": {
                "jsCode": "\nlet fetch = this.helpers.request\n\n\n\n// index.js\nconst helpers = require('/home/node/node_modules/helpers_jsonld')\n\nconst { MongoDB } = require ('/home/node/node_modules/helpers_mongodb')\n\n// const helpers = require('/home/node/node_modules/jsonld_helpers/dist/index.cjs')\nlet URI = 'mongodb://tactik8:Temp4now@192.168.2.243:27017/?authMechanism=DEFAULT'\n\n\n\n\n\n\nfor (const item of $input.all()) {\n\n  let db = new MongoDB()\n  db.uri = URI\n\n  db.databaseID = item.json.config.databaseID\n  db.tenantID = item.json.config.tenantID\n\n  let a_init = await db.init()\n  if(a_init.isCompleted == false){\n          return a_init.record\n      }\n\n\n  let a = await db.search(item.json.action.object?.filter, item.json.action.object?.orderBy, item.json.action.object?.orderDirection, item.json.action.object?.limit, item.json.action.object?.offset)\n\n  let result = a.record?.result || a?.result  || {}\n\n  \n  item.json.action.result = result\n    \n  \n}\n\nreturn $input.all();"
