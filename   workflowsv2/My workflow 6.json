                "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\n\n\nfunction testRecord(name, no = 0, depth = 1) {\n\n\n    name = String(name || \"test\") \n    \n\n    let records = []\n\n    for (let i = 0; i <= no; i++) {\n\n        let item_name = name + \"_\" + String(i)\n        let record = {\n            \"@type\": \"Thing\",\n            \"@id\": \"https://testrecord.com/\" + item_name,\n            \"name\": item_name\n        }\n\n        if(depth > 0){\n            record.other1 = testRecord(item_name, no, depth -1)\n        }\n\n        records.push(record)\n    }\n\n    return no == 0 ? records[0] : records\n\n\n}\n\n\n\n\n\nfor (const item of $input.all()) {\n  item.json.record = testRecord('test_name', 5, 3)\n}\n\nreturn $input.all();"
