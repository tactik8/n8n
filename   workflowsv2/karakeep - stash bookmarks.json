        {
            "parameters": {
                "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n\n  let bookmarks = item.json.karakeep.result.map(x => x.object)\n  let videos = item.json.stash.result\n\n\n  let sameUrls = []\n  let sameName = []\n  let toScrape = []\n  for(let b of bookmarks){\n\n    let alreadyScraped = false\n    \n    for(let v of videos){\n\n      // Get videos with same urls\n      if(v.url.includes(b.url)){\n        sameUrls.push({'bookmark': b, 'stash': v})\n        alreadyScraped = true\n      } \n\n      // Get videos with same title\n      if(v.name == b.name){\n        sameName.push({'bookmark': b, 'stash': v})\n      }\n      \n    }\n\n    if(alreadyScraped == false){\n      toScrape.push(b)\n    }\n    \n  }\n\n\n  item.json = {\n    'sameUrls': sameUrls,\n    'sameName': sameName,\n    'toScrape': toScrape\n  }\n  \n}\n\nreturn $input.all();"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
