        {
            "parameters": {
                "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n\n  let result = []\n  for(let r of item.json.data ){\n  \n    delete r['_id']\n    result.push(r)\n    \n  }\n    item.json = {}\n    item.json.result = result\n}\n\nreturn $input.all();"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1120,
                160
            ],
            "id": "84aaffeb-44d5-4f9e-b934-a5a1ba0f0607",
            "name": "Clean"
        },
        {
            "parameters": {
                "aggregate": "aggregateAllItemData",
                "options": {}
            },
            "type": "n8n-nodes-base.aggregate",
            "typeVersion": 1,
            "position": [
                896,
                160
            ],
            "id": "b1eb75c7-88fe-4a9f-a0ac-8c6ce830249e",
            "name": "Aggregate"
        },
        {
            "parameters": {
                "jsCode": "/**\n * Converts a nested object into a flat object with dot notation keys.\n * @param {Object} obj - The object to flatten.\n * @param {String} prefix - The current key prefix (used for recursion).\n * @returns {Object} - A flattened object suitable for MongoDB queries/updates.\n */\nfunction convertToDotNotation(obj, prefix = \"\") {\n  return Object.keys(obj).reduce((acc, key) => {\n    const propertyPath = prefix ? `${prefix}.${key}` : key;\n    \n    // Check if the value is an object, not null, and not an array\n    // Note: We usually don't flatten arrays for MongoDB updates\n    if (typeof obj[key] === 'object' && obj[key] !== null && !Array.isArray(obj[key])) {\n      Object.assign(acc, convertToDotNotation(obj[key], propertyPath));\n    } else {\n      acc[propertyPath] = obj[key];\n    }\n    \n    return acc;\n  }, {});\n}\n\n// Example Usage:\nconst record = {\n  system: {\n    url: \"https://www.test.com\",\n    settings: {\n      timeout: 5000,\n      enabled: true\n    }\n  },\n  user: \"admin\"\n};\n\n\n\nfor (const item of $input.all()) {\n  item.json.config.filter = convertToDotNotation(item.json.config.filter)\n}\n\nreturn $input.all();"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                432,
                256
            ],
            "id": "564f8ed7-47cb-4199-a195-89a5d80724c9",
