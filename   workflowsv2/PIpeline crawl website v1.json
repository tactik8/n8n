        {
            "parameters": {
                "jsCode": "\n\nfunction toWebpage(record){\n\n\n  if(Array.isArray(record)){\n    return record.map(x => toWebpage(x))\n  }\n\n  let r = {\n    \"@type\": \"WebPage\",\n    \"@id\": (record.metadata?.url || \"\") + \"#webpage\",\n    \"name\": record.metadata?.title || \"\",\n    \"url\": (record.metadata?.url || \"\"),\n    \"image\": {\n      \"@type\": \"ImageObject\",\n      \"@id\": (record.metadata?.url || \"\") + \"#imageobject\",\n      \"contentUrl\": (record.metadata?.ogImage || \"\"),\n      \"url\": (record.metadata?.url || \"\")\n    },\n    \"title\": record.metadata?.title || \"\",\n    \"description\": (record.metadata?.ogDescription || \"\"),\n    \"text\": record.markdown,\n    \n    \n  }\n\n  return r\n}\n\n\n\n// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n  item.json.results = toWebpage(item.json.data.data)\n}\n\nreturn $input.all();"
            },
