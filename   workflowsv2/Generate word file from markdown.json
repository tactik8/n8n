        },
        {
            "parameters": {
                "operation": "upload",
                "bucketName": "={{ $('Config').item.json.config.bucket }}",
                "fileName": "={{ $('Config').item.json.config.filepath }}/{{ $json.action.result.title }}",
                "additionalFields": {}
            },
            "type": "n8n-nodes-base.s3",
            "typeVersion": 1,
            "position": [
                352,
                -16
            ],
            "id": "73333685-841d-4bdd-8e94-3e9191032c6b",
            "name": "Upload a file1",
            "credentials": {
                "s3": {
                    "id": "CdQ69TLyaEtJxpdB",
                    "name": "S3 account"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "const { default: markdownDocx, Packer } = require('/home/node/node_modules/markdown-docx');\n\nasync function convertMarkdownToDocx(markdown) {\n \n  // Convert to docx\n  const doc = await markdownDocx(markdown);\n\n  // Save to file\n  const buffer = await Packer.toBuffer(doc);\n  return buffer\n\n}\n\n// Execute the function\n\n\n\nfor (const item of $input.all()) {\n\n  let action = JSON.parse(JSON.stringify(item.json.action))\n\n\n  let title = item.json.action.object.title\n  if(!title.endsWith(\".docx\")){\n    title = title + '.docx'\n  }\n\n  let baseUrl = item.json.config.baseUrl\n  if(!baseUrl.endsWith('/')){\n    baseUrl = baseUrl + '/'\n  }\n  \n  action.result = {\n    \"@type\": \"DigitalDocument\",\n    \"title\": title,\n    \"url\": `${item.json.config.baseUrl}${item.json.config.bucket}/${item.json.config.filepath}/${title}`\n  }\n\n  \n  return {\n    json: {\"action\": action},\n    binary: {\n      data: {\n        data: await convertMarkdownToDocx(item.json.action.object.text), \n        mimeType: \"application/vnd.openxmlformats-officedocument.wordprocessingml.document\",\n        fileName: title,\n        fileExtension: \"docx\"\n      }\n    }\n  }\n}\n\nreturn $input.all();"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
