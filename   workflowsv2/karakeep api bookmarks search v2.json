        {
            "parameters": {
                "jsCode": "let fetch = this.helpers.request\n\nconst { systems } = require('/home/node/node_modules/helpers_systems')\n\n// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n\n  let url = item.json.action.object.system.url\n  let token = item.json.action.object.credential.token\n\n\n\n\n  \n  let karakeep = new systems.Karakeep(url, token)\n  item.json.action.result = await karakeep.bookmarks.search()\n}\n\nreturn $input.all();"
            },
