                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"query\": \"mutation SceneUpdate($input: SceneUpdateInput!) { sceneUpdate(input: $input) { id url files { id path } } }\",\n  \"variables\": {\n    \"input\": {\n      \"id\": \"{{ $json.id }}\",\n      \"url\": \"{{ $json.url }}\"\n     \n    }\n  }\n}",
                "options": {
                    "batching": {
