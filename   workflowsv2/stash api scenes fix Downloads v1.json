        {
            "parameters": {
                "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n  item.json.data.allScenes = item.json.data.allScenes.filter(x => (x?.files?.[0]?.path || \"\").includes('redgifs'))\n\n  let result = []\n  for(let s of item.json.data.allScenes){\n\n    let f = s.files?.[0]?.path\n    if(!f){\n      continue\n    }\n\n    let name =  f.split('/')\n    name = name[name.length -1]\n    name = name.split('.')\n    name = name.slice(0, name.length -1)\n    name = name.join('.')\n\n    name = name.replace('redgifs_', '')\n\n    name = \"https://www.redgifs.com/watch/\" + name\n    if (s.url != name){\n      s.url = name\n      result.push(s)\n    }\n  }\n  item.json = {result: result}\n}\n\nreturn $input.all();"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                592,
                -224
            ],
            "id": "7a91b507-0e08-4126-99f0-9043e5b1a2bf",
            "name": "Code in JavaScript"
