        {
            "parameters": {
                "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n\n  let m = item.json\n\n    let r = {\n      \"@type\": \"BookmarkAction\",\n      \"@id\": \"https://karakeep.tactik8.com/bookmarks/\" + m.id,\n      \"actionStatus\": \"CompletedActionStatus\",\n      \"object\":{\n        \"@type\": \"WebPage\",\n        \"@id\": m.content.url + \"#webpage\",\n        \"name\": m.content?.title,\n        \"url\": m.content.url,\n        \"description\": m.content.description\n      },\n      \"startTime\": m.createdAt,\n      \"endTime\": m.modifiedAt,\n      \"agent\": {\n        \"@type\": \"Person\",\n        \"@id\": \"https://karakeep.tactik8.com/users/\" + m.userId\n      }\n     \n    }\n    \n  item.json = {}\n\n  item.json.result = r\n}\n\n  return $input.all();"
            },
