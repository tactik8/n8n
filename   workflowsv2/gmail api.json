            "name": "Call 'DW API Post Bronze Record V1'"
        },
        {
            "parameters": {
                "jsCode": "\n\n\n/**\n * Maps a Gmail-like message record to a Schema.org EmailMessage object.\n * \n * @param {Object} record - The source message record.\n * @param {string} record.subject - The subject line of the email.\n * @param {string} record.date - ISO-8601 date string.\n * @param {string} record.text - Plain text content of the email.\n * @param {string} record.messageId - Unique message identifier.\n * @param {Object} record.from - Sender information.\n * @param {Object} record.to - Recipient information.\n * @returns {Object} JSON-LD EmailMessage object.\n */\nfunction transformGmailToSchema(record) {\n    if (!record) return {};\n    const { subject, date, text, messageId, from, to } = record;\n    /**\n     * Helper to map address objects to Schema.org Person or Organization.\n     * @param {Array} contacts - Array of contact objects { name, address }.\n     * @param {string} defaultType - \\\"Person\\\" or \\\"Organization\\\".\n     */\n    const mapContacts = (contacts, defaultType = 'Person') => {\n        if (!contacts || !Array.isArray(contacts)) return undefined;\n\n        return contacts.map(contact => ({\n            '@type': contact.name && contact.name.toLowerCase().includes('google') ? 'Organization' : defaultType,\n            'name': contact.name?.trim() || undefined,\n            'email': contact.address?.trim() || undefined\n\n        })).filter(c => c.name || c.email);\n    };\n    // Attempt to extract the primary action link from the text (Change Spend Caps)\n    const extractActionUrl = (textContent) => {\n      const match = \"\" //textContent?.match(/Change Spend Caps<(https://[^>]+)>/);\n      return match ? match[1] : undefined;\n    };\n    const actionUrl = extractActionUrl(text);\n    const jsonLd = {\n      '@context': 'https://schema.org',\n      '@type': 'EmailMessage',\n      \"@id\": `https://www.gmail.com/message/${messageId}#message`,\n      'identifier': messageId,\n      'subjectLine': subject?.trim(),\n      'datePublished': date,\n      'text': text?.trim(),\n      'sender': mapContacts(from?.value, 'Organization')?.[0], // Usually one sender\n      'recipient': mapContacts(to?.value, 'Person'),\n    };\n    // Add a Potential Action if a CTA link is found\n    if (actionUrl) {\n      jsonLd.potentialAction = {\n        '@type': 'ViewAction',\n        'name': 'Change Spend Caps',\n        'target': actionUrl\n      };\n    }\n    // Clean undefined keys\n    return JSON.parse(JSON.stringify(jsonLd));\n}\n\n\nfor (const item of $input.all()) {\n  item.json.result = item.json.config.rawData.map(x => transformGmailToSchema(x))\n}\n\nreturn $input.all();"
            },
