        {
            "parameters": {
                "jsCode": "const cheerio = require('cheerio');\n\n/**\n * Extracts text from HTML using Cheerio\n * @param {string} html \n * @param {string} selector \n */\nfunction getValueFromHTML(html, schema) {\n\n  function _getValue(c, schema){\n\n    let result = {}\n\n    for(let k of Object.keys(schema)){\n      \n      let selector = schema[k]\n      if(typeof selector != \"string\"){\n        result[k] = _getValue(html, selector)\n      } else {\n        result[k] =  c(selector).text().trim();\n      }\n        \n    }\n\n  \n    return result\n\n\n  }\n  \n  \n  const c = cheerio.load(html);\n  \n  return _getValue(c, schema)\n\n  \n}\n\n\n\n\n\nfor (const item of $input.all()) {\n  item.json.result= getValueFromHTML(item.json.html, item.json.schema)\n}\n\nreturn $input.all();"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                896,
                0
            ],
