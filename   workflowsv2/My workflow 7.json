                -160
            ],
            "id": "183bebd9-f069-4c98-b9ff-ceff1ca372d1",
            "name": "Execute Command"
        },
        {
            "parameters": {
                "jsCode": "// Add JSDOM to your n8n environment variables if self-hosted:\n// NODE_FUNCTION_ALLOW_EXTERNAL=jsdom\nconst { JSDOM } = require('jsdom');\n\nfunction getValueFromHTML(html, schema) {\n  console.log('s')\n  const dom = new JSDOM(html);\n  const doc = dom.window.document;\n\n  function parseSchema(currentSchema) {\n    let result = {};\n\n    for (let k of Object.keys(currentSchema)) {\n      console.log('k', k)\n      let selector = currentSchema[k];\n\n      if (typeof selector === 'object' && selector !== null && !Array.isArray(selector)) {\n        // Recurse for nested objects (brand, offers, etc.)\n        result[k] = parseSchema(selector);\n      } else if (typeof selector === 'string') {\n        // Standard DOM selection\n        const element = doc.querySelector(selector);\n        result[k] = element ? element.textContent.trim() : null;\n      }\n    }\n    return result;\n  }\n\n  return parseSchema(schema);\n}\n\n// n8n processing loop\nfor (const item of $input.all()) {\n  try {\n    const html = item.json.html || \"\";\n    const schema = item.json.schema || {};\n    item.json.result = getValueFromHTML(html, schema);\n  } catch (error) {\n    item.json.error = error.message;\n  }\n}\n\nreturn $input.all();"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                896,
                208
            ],
            "id": "deda0ce8-fd90-4dd8-99bd-4193320e0a18",
            "name": "Code in JavaScript1"
        },
        {
            "parameters": {
                "jsCode": "const cheerio = require('cheerio');\n\nfunction get(html){\n// Get the HTML string from the previous node\n\n// Load the HTML into cheerio\nconst $ = cheerio.load(html);\n\n// Use CSS selectors to extract data\nconst pageTitle = $('h1').text();\nconst links = [];\n\n$('a').each((i, el) => {\n  links.push($(el).attr('href'));\n});\n\n// Return the parsed data to the workflow\nreturn [{\n  json: {\n    title: pageTitle,\n    links: links\n  }\n}];\n\n}\nfor (const item of $input.all()) {\n  item.json.result=get(item.json.html) \n}\n\nreturn $input.all();"
            },
