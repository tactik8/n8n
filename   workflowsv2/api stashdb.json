        {
            "parameters": {
                "jsCode": "/**\n * Converts a StashDB Scene API object into a Schema.org VideoObject JSON-LD format.\n * * @param {Object} scene - The raw scene object fetched from StashDB.\n * @returns {Object} A JSON-LD compliant VideoObject.\n */\nfunction convertStashSceneToJSONLD(scene) {\n  if (!scene) return null;\n\n  // 1. Map StashDB URLs array to find an official or primary link if available\n  const primaryUrl = scene.urls && scene.urls.length > 0 \n    ? scene.urls[0].url \n    : `https://stashdb.org/scenes/${scene.id}`;\n\n  // 2. Map performers to Schema.org Person schemas\n  const actors = (scene.performers || []).map(p => ({\n    \"@type\": \"Person\",\n    \"name\": p.performer ? p.performer.name : (p.as || \"Unknown Performer\"),\n    \"sameAs\": p.performer ? `https://stashdb.org/performers/${p.performer.id}` : undefined\n  }));\n\n  // 3. Map tags to comma-separated keywords\n  const keywords = (scene.tags || []).map(t => t.name).join(\", \");\n\n  // 4. Extract thumbnail/poster images if present\n  const thumbnailUrls = (scene.images || []).map(img => img.url);\n\n  // 5. Convert StashDB duration (seconds) to ISO 8601 Duration format (e.g., PT1H23M45S)\n  let isoDuration = undefined;\n  if (scene.duration) {\n    const hours = Math.floor(scene.duration / 3600);\n    const minutes = Math.floor((scene.duration % 3600) / 60);\n    const seconds = Math.floor(scene.duration % 60);\n    \n    isoDuration = \"PT\";\n    if (hours > 0) isoDuration += `${hours}H`;\n    if (minutes > 0) isoDuration += `${minutes}M`;\n    if (seconds > 0 || isoDuration === \"PT\") isoDuration += `${seconds}S`;\n  }\n\n  // Assemble the JSON-LD payload\n  const jsonLd = {\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"VideoObject\",\n    \"@id\": `https://stashdb.org/scenes/${scene.id}`,\n    \"name\": scene.title || \"Untitled Scene\",\n    \"description\": scene.details || `Scene item listed under ID ${scene.id}`,\n    \"url\": primaryUrl,\n    \"duration\": isoDuration,\n    \"uploadDate\": scene.date || undefined,\n    \"keywords\": keywords || undefined,\n    \"actor\": actors.length > 0 ? actors : undefined,\n  };\n\n  // Add Production Company if a Studio exists\n  if (scene.studio && scene.studio.name) {\n    jsonLd.productionCompany = {\n      \"@type\": \"Organization\",\n      \"name\": scene.studio.name,\n      \"@id\": `https://stashdb.org/studios/${scene.studio.id}`\n    };\n  }\n\n  // Add Director if available\n  if (scene.director) {\n    jsonLd.director = {\n      \"@type\": \"Person\",\n      \"name\": scene.director\n    };\n  }\n\n  // Add Content/SKU Code under identifier tracking\n  if (scene.code) {\n    jsonLd.identifier = scene.code;\n  }\n\n  // Embed Thumbnail Images\n  if (thumbnailUrls.length > 0) {\n    jsonLd.thumbnailUrl = thumbnailUrls;\n  }\n\n  return jsonLd;\n}\n\n\n\nfor (const item of $input.all()) {\n  let results = []\n\n  for(let s of item.json.data.queryScenes.scenes){\n    let r = convertStashSceneToJSONLD(s)\n    results.push(r)\n  }\n  item.json = {}\n  item.json.result = results\n}\n\nreturn $input.all();"
            },
