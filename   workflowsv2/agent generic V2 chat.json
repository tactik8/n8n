        {
            "parameters": {
                "jsCode": "let fetch = this.helpers.request\n// index.js\nconst {helpers} = require('/home/node/node_modules/helpers_jsonld')\n\n\nfor (const item of $input.all()) {\n  let c = new helpers.things.Conversation(item.json.action.result)\n\n  let m = c.lastMessage\n\n  let t = m.text\n\n  item.json.output = t\n\n}\n\nreturn $input.all();"
            },
            "type": "n8n-nodes-base.code",
