            "parameters": {
                "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n  if(!item.json.config.filter.user.email){\n    delete item.json.config.filter.user.email\n  }\n  if(!item.json.config.filter.user.accountId){\n    delete item.json.config.filter.user.accountId\n  }\n}\n\nreturn $input.all();"
