                "parameters": {
                    "jsCode": "/**\n * Converts a TaskView task record into a Schema.org JSON-LD object.\n *\n * @param {Object} task - The TaskView task record.\n * @returns {Object} Schema.org JSON-LD representation (type: Action).\n */\nfunction taskToSchemaJsonLd(baseUrl, className, task) {\n  \n\n  baseUrl = baseUrl.endsWith('/') ? baseUrl.slice(0, baseUrl.length -1) : baseUrl\n  \n  \n  // Map TaskView status strings to official Schema.org ActionStatusType URLs\n  const statusMap = {\n    open: \"https://schema.org/PotentialActionStatus\",\n    todo: \"https://schema.org/PotentialActionStatus\",\n    pending: \"https://schema.org/PotentialActionStatus\",\n    in_progress: \"https://schema.org/ActiveActionStatus\",\n    active: \"https://schema.org/ActiveActionStatus\",\n    completed: \"https://schema.org/CompletedActionStatus\",\n    done: \"https://schema.org/CompletedActionStatus\",\n    failed: \"https://schema.org/FailedActionStatus\",\n    cancelled: \"https://schema.org/FailedActionStatus\"\n  };\n\n  const normalizedStatus = task.status?.toLowerCase().replace(/\\s+/g, \"_\");\n  const actionStatus =\n    statusMap[normalizedStatus] || \"https://schema.org/PotentialActionStatus\";\n\n  const jsonLd = {\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"Action\",\n    \"@id\": `${baseUrl}/${className}/${task.id || task.taskId}#action`,\n    name: task.title || task.name,\n    description: task.description || task.notes,\n    actionStatus: actionStatus,\n    startTime: task.startDate || task.createdAt,\n    endTime: task.completedAt || task.dueDate,\n    url: task.url,\n    ...(task.assignee && {\n      agent: {\n        \"@type\": \"Person\",\n        name: typeof task.assignee === \"string\" ? task.assignee : task.assignee.name,\n        ...(task.assignee.email && { email: task.assignee.email })\n      }\n    }),\n    ...(task.project && {\n      instrument: {\n        \"@type\": \"Project\",\n        name: typeof task.project === \"string\" ? task.project : task.project.name\n      }\n    }),\n    ...(Array.isArray(task.tags) && task.tags.length > 0 && {\n      keywords: task.tags.join(\", \")\n    }),\n    ...(task.priority && {\n      additionalProperty: {\n        \"@type\": \"PropertyValue\",\n        name: \"priority\",\n        value: String(task.priority)\n      }\n    })\n  };\n\n  // Remove keys with undefined or null values\n  return Object.fromEntries(\n    Object.entries(jsonLd).filter(([_, value]) => value !== undefined && value !== null)\n  );\n}\n\n\n\nfor (const item of $input.all()) {\n\n  let records = item.json.action.object\n  records = Array.isArray(records) ? records : [records]\n  let results = []\n  for(let r of records){\n    let baseUrl = (r?.['@id'] || '').split('#')[0]\n    let className = \"task\"\n\n    let sourcerecord = r?.dataFeedElement?.item['@graph']?.[0]?.task\n\n    if(sourcerecord){\n      results.push( taskToSchemaJsonLd(baseUrl,className, sourcerecord))\n              \n    }\n    \n\n    \n  }\n  item.json.action.result = results\n  \n}\n\nreturn $input.all();"
                },
