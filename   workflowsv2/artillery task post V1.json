        {
            "parameters": {
                "jsCode": "// 1. A lightweight, zero-dependency HTML parser for sandboxed environments\nfunction parseHTMLForms(html) {\n  const forms = [];\n  let currentForm = null;\n\n  // Tokenize the HTML string into tags and text chunks\n  const tagRegex = /<([^>]+)>/g;\n  let match;\n  let lastIndex = 0;\n\n  while ((match = tagRegex.exec(html)) !== null) {\n    const tagContent = match[1].trim();\n    const isClosing = tagContent.startsWith('/');\n    const isSelfClosing = tagContent.endsWith('/');\n    \n    // Normalize tag content (strip leading/trailing slashes)\n    let cleanTag = tagContent;\n    if (isClosing) cleanTag = cleanTag.substring(1);\n    if (isSelfClosing) cleanTag = cleanTag.substring(0, cleanTag.length - 1);\n    cleanTag = cleanTag.trim();\n\n    const spaceIndex = cleanTag.indexOf(' ');\n    const tagName = (spaceIndex === -1 ? cleanTag : cleanTag.substring(0, spaceIndex)).toLowerCase();\n    const rawAttrs = spaceIndex === -1 ? '' : cleanTag.substring(spaceIndex + 1);\n\n    // Helper to parse attributes from a tag string\n    const parseAttrs = (attrStr) => {\n      const attrs = {};\n      const attrRegex = /([a-zA-Z0-9:-]+)(?:\\s*=\\s*(?:'([^']*)'|\"([^\"]*)\"|([^\\s>]+)))?/g;\n      let attrMatch;\n      while ((attrMatch = attrRegex.exec(attrStr)) !== null) {\n        const key = attrMatch[1];\n        const val = attrMatch[2] ?? attrMatch[3] ?? attrMatch[4] ?? \"\";\n        attrs[key] = val;\n      }\n      return attrs;\n    };\n\n    if (tagName === 'form') {\n      if (!isClosing) {\n        // Start of a new form\n        currentForm = {\n          attributes: parseAttrs(rawAttrs),\n          inputs: []\n        };\n      } else if (currentForm) {\n        // End of the current form\n        forms.push(currentForm);\n        currentForm = null;\n      }\n    } else if (currentForm && ['input', 'select', 'textarea', 'button'].includes(tagName)) {\n      if (!isClosing) {\n        const attributes = parseAttrs(rawAttrs);\n        let value = attributes.value || '';\n\n        // If it's a textarea or select, we might need to grab its text value.\n        // We look ahead to the next closing tag to fetch any inner content.\n        if (tagName === 'textarea' || tagName === 'select') {\n          const nextTagIndex = tagRegex.lastIndex;\n          const closeTagPattern = new RegExp(`</${tagName}\\\\s*>`, 'i');\n          const closeMatch = closeTagPattern.exec(html.substring(nextTagIndex));\n          \n          if (closeMatch) {\n            const innerContent = html.substring(nextTagIndex, nextTagIndex + closeMatch.index).trim();\n            if (tagName === 'textarea') {\n              value = innerContent;\n            } else if (tagName === 'select') {\n              // Extract the selected option's value\n              const optMatch = /<option[^>]*selected[^>]*value=[\"']([^\"']*)[\"']/i.exec(innerContent) \n                            || /<option[^>]*value=[\"']([^\"']*)[\"']/i.exec(innerContent);\n              value = optMatch ? optMatch[1] : '';\n            }\n          }\n        }\n\n        currentForm.inputs.push({\n          tagName,\n          attributes,\n          value\n        });\n      }\n    }\n  }\n\n  return forms;\n}\n\n\nfunction getForm(html, formID){\n\n  let forms = parseHTMLForms(html)\n\n  let f = forms.find(x => x?.attributes.id == formID )\n\n  let record = {}\n  f.inputs.filter(x => x.attributes.type !=\"submit\").forEach(x => record[x.attributes.id] = x.value || \"tbd\" )\n\n  \n}\n\n\n\nfor (const item of $input.all()) {\n  item.json = {\"result\": getForm(item.json.data, 'fGet'), \"Cookies\": $input.first().json.headers['set-cookie'][0]}\n}\n\nreturn $input.all();"
            },
