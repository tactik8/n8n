        {
            "parameters": {
                "jsCode": "const puppeteer = require('/home/node/node_modules/puppeteer-core');\n\nasync function scrapeUrl(url) {\n    const targetUrl = url;\n    let browser;\n    \n    try {\n        // 1. Fetch the exact browser WebSocket endpoint dynamically via the HTTP JSON endpoint\n        const response = await fetch('http://192.168.2.243:9222/json/version');\n        const data = await response.json();\n        const browserWSEndpoint = data.webSocketDebuggerUrl;\n\n        if (!browserWSEndpoint) {\n            throw new Error('Could not retrieve webSocketDebuggerUrl from browser.');\n        }\n\n        // 2. Connect using the full WebSocket URL\n        browser = await puppeteer.connect({\n            browserWSEndpoint: browserWSEndpoint\n        });\n\n        const page = await browser.newPage();\n        await page.goto(targetUrl, { waitUntil: 'networkidle2' });\n\n        const htmlContent = await page.content();\n        const title = await page.title();\n        \n        // Always close the page when done to prevent memory leaks in the remote browser\n        await page.close();\n\n        return {\n            url: targetUrl,\n            title: title,\n            html: htmlContent\n        };\n    } catch (err) {\n        return {\n            url: targetUrl,\n            error: String(err)\n        };\n    } finally {\n        if (browser) {\n            await browser.disconnect();\n        }\n    }\n}\n\n// 3. Properly handle async operations in a loop for n8n items\nfor (const item of $input.all()) {\n    // Make sure your input item structure actually contains item.json.config.url\n    const urlToScrape = item.json.config?.url || item.json.url;\n    const result = await scrapeUrl(urlToScrape);\n    \n    item.json.result = result;\n}\n\nreturn $input.all();"
            },
