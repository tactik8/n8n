        {
            "parameters": {
                "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\n\n\n\nfunction isIn(items, item){\n\n  if(item === undefined || item === null){\n    return true\n  }\n\n  items = Array.isArray(items) ? items : [items]\n  if(items.length === 0){\n    return false\n  }\n\n  \n  for(let i of items){\n    if(i == item){\n      return true\n    } \n\n    if(i?.['@type'] && i?.['@id'] && i?.['@type'] == item?.['@type'] && i?.['@id'] == item?.['@id']){\n      return true\n    } \n\n    \n  }\n\n  return false\n  \n}\n\n\n\nlet newRecords = []\nfor (const item of $input.all()) {\n  item.json.myNewField = 1;\n\n  let dbRecord = item.json.dbRecord\n\n  dbRecord._tenantID = item.json.tenantID\n  dbRecord._projectID = item.json.projectID\n\n  let newRecord = item.json.record\n\n  let record = item.json?.dbRecord \n\n  if(record === undefined){\n    record = newRecord\n    newRecords.push(record)\n    continue\n  }\n  \n  for(let k in newRecord){\n    \n    let dbValue = dbRecord?.[k]\n    let newValue = newRecord?.[k]\n\n\n    // Undefined or null\n    if(dbValue === undefined || dbValue === null){\n      record[k] = newValue\n      continue\n    }\n\n    let dbValues = Array.isArray(dbValue) ? dbValue : [dbValue]\n\n    let newValues = Array.isArray(newValue) ? newValue : [newValue]\n\n    for(let v of newValues){\n      if(isIn(dbValues, v) === false){\n        dbValues.push(v)\n      }\n    }\n\n    // Clean up\n    if(dbValues.length === 1){\n      record[k] = dbValues?.[0]\n    } else {\n      record[k] = dbValues\n    }\n    \n    \n  }\n\n  newRecords.push(record)\n  \n}\n\nreturn newRecords"
            },
