            "parameters": {
                "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\n\nlet promptRecord = {}\nfor (const item of $input.all()) {\n  let category = item.json.category\n  promptRecord[category] = promptRecord[category] || ''\n  promptRecord[category] += item.json.value\n  \n}\nlet content = ''\nfor(let k in promptRecord){\n  content += \"**\" + k + \"**:\"\n  content += promptRecord[k]\n  content += \"  \"\n}\n\nlet output = {\n  result: content\n}\n\nreturn output"
