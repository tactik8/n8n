        {
            "parameters": {
                "mode": "runOnceForEachItem",
                "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfunction getDomainFromUrl(urlString) {\n\n            if(!urlString){\n              return null\n            }\n            let hostname = urlString.trim();\n\n            // Step 1: Remove the protocol (e.g., \"http://\", \"https://\")\n            const protocolIndex = hostname.indexOf('://');\n            if (protocolIndex > -1) {\n                hostname = hostname.substring(protocolIndex + 3);\n            }\n\n            // Step 2: Remove user info (e.g., \"user:pass@\")\n            const atIndex = hostname.indexOf('@');\n            if (atIndex > -1) {\n                hostname = hostname.substring(atIndex + 1);\n            }\n\n            // Step 3: Remove path, query string, and fragment identifier.\n            // This isolates the host and port.\n            const pathIndex = hostname.indexOf('/');\n            if (pathIndex > -1) {\n                hostname = hostname.substring(0, pathIndex);\n            }\n            const queryIndex = hostname.indexOf('?');\n            if (queryIndex > -1) {\n                hostname = hostname.substring(0, queryIndex);\n            }\n            const hashIndex = hostname.indexOf('#');\n            if (hashIndex > -1) {\n                hostname = hostname.substring(0, hashIndex);\n            }\n            \n            // Step 4: Remove the port number.\n            const portIndex = hostname.indexOf(':');\n            if (portIndex > -1) {\n                hostname = hostname.substring(0, portIndex);\n            }\n\n            // Return the extracted hostname, or null if it's an empty string.\n            return \"https://\" + hostname || null\n        }\n\n        \n  $json.url = getDomainFromUrl($json?.url)\n  $json[\"@id\"] = $json.url\n\nreturn $json"
            },
