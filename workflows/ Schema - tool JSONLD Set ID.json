            "parameters": {
                "jsCode": "function generateUUID() {\n  let d = new Date().getTime(); // Timestamp\n  let d2 = ((typeof performance !== 'undefined') && performance.now && (performance.now() * 1000)) || 0; // High-res timestamp\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\n    let r = Math.random() * 16; // Random number between 0 and 16\n    if (d > 0) { // Use timestamp until it's consumed\n      r = (d + r) % 16 | 0;\n      d = Math.floor(d / 16);\n    } else { // Use high-res timestamp if available\n      r = (d2 + r) % 16 | 0;\n      d2 = Math.floor(d2 / 16);\n    }\n    return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);\n  });\n}\n\n\nfunction nestedFnGenerator(value, fnOnValue, fnOnObject, fnOnArray){\n\n  console.log('input')\n  console.log('r', value)\n  fnOnArray = fnOnArray || fnOnValue\n  fnOnObject = fnOnObject || fnOnValue\n  \n  // If array\n  if(Array.isArray(value)){\n    console.log('is array')\n    value = value.map(x => nestedFnGenerator(x, fnOnValue, fnOnObject, fnOnArray))\n    value = value.map(x => fnOnArray(x))\n    return value\n  }\n\n\n  // If object \n  if(typeof value === 'object' && value !== null){\n    value = fnOnObject(value)\n\n    if(typeof value === 'object' && value !== null){\n      let keys = Object.keys(value)\n      for(let k of keys){\n        value[k] = fnOnObject(value[k])\n        value[k] = nestedFnGenerator(value[k], fnOnValue, fnOnObject, fnOnArray)\n      }\n    }\n    return value\n  }\n\n\n  // Else\n  console.log('is value')\n\n  value = fnOnValue(value)\n  return value\n  \n}\n\n\nfunction assignID(value){\n\n  if(typeof value === 'object' && value !== null){\n\n    value['@id'] = value?.['@id'] || generateUUID()\n    \n  }\n  return value\n}\n\n\n\n\n// Process all items\nfor (let item of $input.all()){\n  item.json = nestedFnGenerator(item.json?.content, assignID)\n}\n\nreturn  $input.all()"
