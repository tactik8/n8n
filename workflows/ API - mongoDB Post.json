        {
            "parameters": {
                "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nlet results = []\nfor (const item of $input.all()) {\n\n  let values = item.json?.records || undefined\n  if(values){\n\n    let values = item.json.records\n    values = Array.isArray(values) ? values : [values]\n    for(let v of values){\n  \n      if(!v){\n        continue\n      }\n      \n      v['_tenantID'] = item.json?.['tenantID'] || null\n      v['_projectID'] = item.json?.['projectID'] || null\n      results.push(v)\n    }\n  }\n}\n\nresults = results.length === 1 ? results[0] : results\nconsole.log('r', results)\nreturn results"
            },
