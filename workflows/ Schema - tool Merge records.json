        {
            "parameters": {
                "jsCode": "\n\nfunction containsValue(values, value){\n\n  values = Array.isArray(values) ? values : [values]\n    \n  for(let v of values){\n\n    if(value?.['@type'] && value?.['@id']){\n      if(v?.['@type'] == value?.['@type']){\n        if(v?.['@id'] == value?.['@id']){\n          return true\n      }\n    }\n    }\n\n    if(v == value){\n      return true\n    }\n  }\n  return false\n  \n}\n\nfunction mergeObject(object1, object2){\n  \n  let newObject = {}\n\n  for(let k in object1){\n    \n    let values1 = object1?.[k]\n    values1 = Array.isArray(values1) ? values1 : [values1]\n    values1 = values1.filter(x => x !== undefined && x !== null)\n\n    \n    let values2 = object2?.[k]\n    values2 = Array.isArray(values2) ? values2 : [values2]\n    values2 = values2.filter(x => x !== undefined && x !== null)\n\n    let newValues = []\n\n    for(let v1 of values1){\n      if(containsValue(newValues, v1) === false){\n        newValues.push(v1)\n      }\n    }\n    \n    for(let v2 of values2){\n      if(containsValue(newValues, v2) === false){\n        newValues.push(v2)\n      }\n    }\n\n    newValues = newValues.length === 1 ? newValues[0] : newValues\n\n    newObject[k] = newValues\n\n    \n  }\n\n  return newObject\n  \n  \n\n}\n\n\nfunction mergeMultipleObjects(objects){\n\n  let base = objects[0]\n\n  for(let i=1; i< objects.length; i++){\n    base = mergeObject(base, objects[i])\n  }\n  return base\n}\n\n\n// Process all items\nfor (let item of $input.all()){\n  item.json = mergeMultipleObjects([item.json.object1, item.json.object2, item.json.object3, item.json.object4, item.json.object5])\n}\n\nreturn  $input.all()\n"
            },
