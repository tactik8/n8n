        {
            "parameters": {
                "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\n\n\nfunction removeArray(value){\n\n\n  if(Array.isArray(value)){\n    return value[0]\n  }\n\n  if(typeof value === \"object\"){\n    let newValue = {}\n    for(let k in value){\n      newValue[k] = removeArray(value[k])\n    }\n    return newValue\n  }\n  \n  return value\n}\n\nfor (const item of $input.all()) {\n\n  let products = []\n\n  let records = []\n  try{\n    records = JSON.parse(item.json.content)\n  } catch(error){\n    \n  }\n\n  \n  records = Array.isArray(records) ? records : [records]\n\n  for(let d of records){\n\n    let record_type = d?.[\"@type\"] || ''\n    record_type = record_type.toLowerCase()\n    if(record_type != 'product' ){\n      continue\n    }\n\n\n    d = removeArray(d)\n\n    \n    let record = {}\n      \n    record._type = d?.['@type'] || null\n    record._id = d?.['@id'] || null\n    record.name = d?.name  || null\n    record.description = d?.description || null\n    record.sku = d?.sku || null\n    record.mpn = d?.mpn || null\n    record.brand = d?.brand?.name || d?.brand || null\n    record.manufacturer = d?.manufacturer?.name || d?.manufacturer || null\n    record.image = d?.image?.url || d?.image  || null\n    record.offers_price = d?.offers?.price || null\n    record.offers_priceCurrency = d?.offers?.priceCurrency || null\n    record.offers_availability = d?.offers?.availability || null\n    record.offers_url = d.offers.url || null\n    \n    products.push(record)\n  }\n  item.json.products = products\n  \n}\n\nreturn $input.all()"
            },
