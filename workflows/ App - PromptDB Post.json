        {
            "parameters": {
                "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nlet records = []\nfor (const item of $input.all()) {\n\n  for(let k in item.json.promptRecord){\n\n    if(k == \"name\" || k==\"id\"){\n      continue\n    }\n\n    let values = item.json.promptRecord[k]\n    values = Array.isArray(values) ? values : [values]\n    for(let v of values){\n      \n    \n        let record = {\n          \"id\": item.json.promptRecord?.id,\n          \"name\": item.json.promptRecord?.name,\n          \"category\": k,\n          \"value\": v\n        }\n        records.push(record)\n      \n    }\n    \n  }\n\n  \n}\n\nreturn records"
            },
